# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL and keys from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The service-role key bypasses RLS. It is the only key that can read or write
# anything here, and it must never be exposed to the browser — no NEXT_PUBLIC_
# prefix, server-side routes only.
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic ───────────────────────────────────────────────────────────────
# Used by the capture classifier, the Priorities rationale and the weekly
# review draft. Never called on page load — only on an explicit capture or an
# explicit regenerate.
ANTHROPIC_API_KEY=
# Only needed if your key is "identity-linked" (tied to you rather than to one
# workspace). Those keys must name the workspace each request acts in, and the
# API returns a 400 saying so if it is missing. A workspace-scoped key carries
# this already — leave the line blank in that case.
ANTHROPIC_WORKSPACE_ID=

# ── Who this dashboard is for ───────────────────────────────────────────────
# Shown on the Operator card at the top of Home. Not secret — just personal,
# which is why they are configured here rather than committed to the repo.
NEXT_PUBLIC_OPERATOR_NAME=Your name
NEXT_PUBLIC_OPERATOR_TRACK=What you are going for
NEXT_PUBLIC_OPERATOR_LOCATION=CITY, ST
# The school the outreach radar looks for alumni at, e.g. "State University".
# Leave it blank and the alumni search refuses to run — which is deliberate:
# searching for alumni of no university invites the model to invent one.
NEXT_PUBLIC_OPERATOR_UNIVERSITY=

# ── Clock ───────────────────────────────────────────────────────────────────
# The zone every day/week/month boundary is resolved in. Vercel runs UTC;
# without this the habit grid would reset in the middle of your evening.
NEXT_PUBLIC_APP_TIMEZONE=America/Chicago

# ── Calendar ────────────────────────────────────────────────────────────────
# Google Calendar → the target calendar's Settings → "Secret address in iCal
# format". Read-only, no OAuth. Point it at a dedicated "Job Search" calendar
# so the feed only ever carries recruiting events.
CALENDAR_ICS_URL=

# ── Nightly backup cron ─────────────────────────────────────────────────────
# A fine-grained PAT with contents:write on the private backup repo.
GITHUB_BACKUP_TOKEN=
GITHUB_BACKUP_REPO=your-username/recruiting-dashboard-backups
GITHUB_BACKUP_BRANCH=main
# Vercel sends this as a bearer token on scheduled invocations; the cron route
# refuses anything else so the endpoint is not open to the internet.
CRON_SECRET=

# ── Password screen ─────────────────────────────────────────────────────────
# The one password that unlocks the dashboard once it is on the internet. Use
# a long passphrase — four or five unrelated words beats a short clever
# password by a wide margin, and your phone's password manager will remember it.
#
# Leave BOTH blank on your own machine and `npm run dev` runs with no password,
# as before. A deployed copy with either one missing refuses to open at all.
APP_PASSWORD=
# A long random string that signs the login cookie. Generate one with:
#   openssl rand -base64 32
# Changing this or APP_PASSWORD signs out every device at once.
AUTH_SECRET=

# ── Login alert emails ──────────────────────────────────────────────────────
# resend.com → API Keys → Create. The free plan sends 100 emails a day.
RESEND_API_KEY=
# Must be the email address you signed up to Resend with. Until you verify a
# domain of your own, Resend only delivers to the account owner.
LOGIN_ALERT_TO=

# ── Public demo ─────────────────────────────────────────────────────────────
# Set to 1 ONLY on the separate demo deployment (lanework-demo), never here.
#
# It opens the site with no password — the one deliberate exception to the
# rule that the gate fails closed — and switches off login alerts, the nightly
# backup and the live calendar feed. It also arms a job that deletes every row
# in the database each night and writes the fictional seed back.
#
# Because of that last part, demo mode refuses to serve or erase anything
# unless the database it is connected to carries a `demo_marker` table, which
# only supabase/demo/schema.sql creates. Point this at the real Supabase
# project and it stops rather than wiping it.
#
# Leave blank on your own machine and on the real deployment.
NEXT_PUBLIC_DEMO_MODE=
