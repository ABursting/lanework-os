{
  "name": "recruiting-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "NEXT_PUBLIC_APP_TIMEZONE=America/Chicago CALENDAR_ICS_URL=https://example.invalid/private.ics node --import tsx --conditions react-server --test test/*.test.ts",
    "check": "node --env-file=.env.local scripts/check-env.mjs",
    "eval": "node --env-file=.env.local --import tsx --conditions react-server evals/run.ts",
    "mcp": "node --env-file=.env.local --import tsx --conditions react-server scripts/mcp.ts",
    "import-connections": "node --env-file=.env.local --import tsx --conditions react-server scripts/import-connections.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@modelcontextprotocol/server": "^2.3.1",
